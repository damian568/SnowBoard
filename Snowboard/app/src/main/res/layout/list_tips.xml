<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tip_cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/list_margin"
    app:cardBackgroundColor="@color/blush"
    app:cardCornerRadius="@dimen/card_corner"
    app:cardElevation="@dimen/elevation"
    app:contentPadding="@dimen/content_padding">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/contain_margin">

        <ImageView
            android:id="@+id/icon_info"
            android:layout_width="@dimen/list_img"
            android:layout_height="@dimen/list_img"
            android:layout_marginEnd="@dimen/contain_margin"
            android:src="@drawable/ic_equipment"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title"
            android:layout_width="@dimen/no_dimen"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tip_start_end"
            android:layout_marginEnd="@dimen/tip_start_end"
            android:layout_toEndOf="@id/icon_info"
            android:text="Bend Your Knees"
            android:textColor="@color/midnight"
            android:textSize="@dimen/tip_title"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/icon_info"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>