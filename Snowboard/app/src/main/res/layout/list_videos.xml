<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/list_margin"
    app:cardBackgroundColor="@color/blush"
    app:cardCornerRadius="@dimen/card_corner"
    app:cardElevation="@dimen/elevation"
    app:contentPadding="@dimen/content_padding">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/contain_margin">

        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
            android:id="@+id/webVideos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/contain_margin"
            android:importantForAccessibility="no"
            app:enableAutomaticInitialization="false"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/titleVideos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bend Your Knees"
            android:textColor="@color/midnight"
            android:textSize="@dimen/video_title"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/webVideos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/descriptionVideos" />

        <TextView
            android:id="@+id/descriptionVideos"
            android:layout_width="@dimen/no_dimen"
            android:layout_height="wrap_content"
            android:text="Here is the detailed tip about bending your knees while snowboarding..."
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleVideos" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>