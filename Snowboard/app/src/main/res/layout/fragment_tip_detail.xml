<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/tip_detail_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:context=".Fragments.Detail.TipDetailFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/contain_margin"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/detail_width_height">

                <ImageView
                    android:id="@+id/tip_detail_img"
                    android:layout_width="@dimen/detail_width_height"
                    android:layout_height="@dimen/detail_width_height"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_equipment" />

                <ImageButton
                    android:id="@+id/tip_btn_close"
                    android:layout_width="@dimen/close_btn_detail"
                    android:layout_height="@dimen/close_btn_detail"
                    android:layout_margin="@dimen/contain_margin"
                    android:layout_gravity="top|start"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close" />

            </FrameLayout>

            <TextView
                android:id="@+id/tip_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/title_margin"
                android:text="Tip Title"
                android:textColor="@color/midnight"
                android:textSize="@dimen/detail_title_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tip_detail_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/start_end_margin"
                android:layout_marginEnd="@dimen/start_end_margin"
                android:layout_marginBottom="@dimen/detail_margin_bot"
                android:lineSpacingExtra="@dimen/spacing"
                android:text="Full description goes here..."
                android:textSize="@dimen/detail_desc_text" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>